<!-- Add to /var/ossec/etc/ossec.conf on the Wazuh server, then: systemctl restart wazuh-manager -->
<ossec_config>
  <global>
    <white_list>192.168.99.132</white_list>
  </global>
  <active-response>
    <command>firewall-drop</command>
    <location>local</location>
    <rules_id>100100</rules_id>
    <timeout>600</timeout>
  </active-response>
</ossec_config>
